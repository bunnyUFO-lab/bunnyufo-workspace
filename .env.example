# Optional fal.ai generation account.
FAL_KEY=

# Optional extra provider account. No service uses it automatically.
OPENROUTER_API_KEY=

# Shared-GPU handoff and gallery (tools/gpu). Blank uses the defaults: Sprite Studio http://127.0.0.1:8190,
# ComfyUI http://127.0.0.1:8188, Ollama http://127.0.0.1:11434, the gallery card and 12 GB.
# Sprite Studio on another machine: set SPRITE_STUDIO_URL as a user environment variable rather than here, so your
# agents' sprite-studio MCP setting can use it too.
SPRITE_STUDIO_URL=
COMFY_URL=
OLLAMA_URL=
GALLERY_DIR=
SPRITE_STUDIO_SHARE_MAX_GB=
