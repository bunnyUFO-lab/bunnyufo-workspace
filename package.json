{
  "name": "bunnyufo-workspace",
  "private": true,
  "version": "0.4.18",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix server ci",
    "predev": "node scripts/ensure-workspace-link.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "service": "node server/main.mjs",
    "test:site-api": "node --test site/api/test/*.test.mjs site/card-api/test/*.test.mjs site/asks-bot/test/*.test.mjs",
    "test:service": "node --test server/test/*.test.mjs",
    "test:service:ui": "node scripts/run-ui-tests.mjs",
    "test": "npm run test:service && npm run test:site-api && npm run docs:test && node --test scripts/publish.test.mjs scripts/cards.test.mjs scripts/check-leaks.test.mjs scripts/routine-prompt.test.mjs",
    "test:preview": "node scripts/check-preview-ui.mjs",
    "test:template": "node scripts/check-template.mjs && node scripts/docs-sync.mjs --check --template",
    "docs": "node scripts/docs.mjs serve",
    "docs:build": "node scripts/docs.mjs build",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:test": "node --test scripts/docs-*.test.mjs",
    "workspace": "node scripts/workspaces.mjs",
    "publish": "node scripts/publish.mjs",
    "cards": "node scripts/cards.mjs",
    "redeploy": "node tools/workspace/redeploy.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/highlight": "^1.2.5",
    "@types/three": "^0.185.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.4"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
