# The Workspace site, shown with the Workspace app's own UI (browser mode).
#
# One port, one app, every section. The app asks for /sites.json to learn what this site serves, and the
# first path segment picks one: /magic-loops, /bunnylink. Each section's files come from its own base
# under /w/, which is what lets a single copy of the app show any of them, with a switcher in the top bar.
#
# Compression: JavaScript, CSS, HTML, JSON and the other text types named in `encode` below, with zstd or gzip.
# Event streams (text/event-stream: the Hub's chat and run streams) are left out on purpose, see the `encode`
# block. Hashed assets under /assets/ are cached for a year.
#
# $BUW_DOCS_ROOT/_app/ui  the app's built UI, published by site/deploy/publish-ui.sh
#                         ($BUW_DOCS_ROOT is /srv/buw-docs unless Caddy's environment says otherwise)
# buw-site-api:8099       the data service ($BUW_DOCS_ROOT/_app/api): it streams every section out of
#                         the cards bucket and keeps pins, archives and tags in state.json there. The
#                         bucket and its key are in $BUW_DOCS_ROOT/_app/api.env, root-only.
#
# Nothing under $BUW_DOCS_ROOT/<id>/ is read any more: cards reach the site by `npm run publish`
# uploading them to the bucket, and the service serves the bucket. Adding a section: publish it,
# or start it from the site's switcher. No change here.
# Writes (anything but GET, HEAD, OPTIONS) are accepted only from the proxy that does the login
# (NPM_IP, set in this container's environment); anyone else on the LAN gets read-only. With no
# NPM_IP the address is 127.0.0.1, so every write from the LAN is refused: it fails closed. The
# peer is matched with remote_ip, the TCP address, never X-Forwarded-For, which any client can set.
# Remote-User is stripped from every request not from that proxy, so it cannot be forged from the LAN.
# Reached from outside behind an authenticating proxy; the compose file this runs under lives in
# the Caddy stack's folder on the server (CADDY_DIR in site/deploy/publish-site-api.sh).
#
# The content host (optional). A page an agent wrote must not act as the signed-in owner, so card pages are
# also served from a second host name in the same registrable domain: $BUW_CONTENT_HOST (a bare host name, in
# Caddy's environment, beside BUW_CONTENT_ORIGIN in the API's). There the page's origin is not the app's, so it
# cannot read the app's storage, and a write it sends to the app carries the wrong Origin and is refused. The
# session cookie still reaches it (same site), so its images, styles and scripts load behind the sign-in.
#   - On the content host Caddy serves only /w/*, each response with the sandbox CSP below, and 404s the rest.
#   - On the app host, a /w/* page loaded as a document, frame or embed (Sec-Fetch-Dest) is sent on to the content
#     host. Frames are pointed at the content host by the app itself (`contentOrigin` in /api/capabilities).
#   - With BUW_CONTENT_HOST unset nothing changes: no redirect, and the placeholder host below matches nothing.
#
# This file is deployed by site/deploy/publish-site-api.sh: validated, copied to
# $CADDY_DIR/Caddyfile, and Caddy restarted when it changed.
{
	admin off
	auto_https off
}

# Refuses a write that did not come from the login proxy. It lives inside each proxying handle because Caddy
# runs `handle` before a top-level `respond`, so a top-level rule would never fire for these paths.
(npm_only_writes) {
	@outsideWrite {
		not remote_ip {$NPM_IP:127.0.0.1}
		not method GET HEAD OPTIONS
	}
	respond @outsideWrite "Read-only here: writes go through the signed-in address." 403
}

:4000 {
	# Access log, so a request that never arrives can be told apart from one that was
	# refused here. Goes to the container's stdout: `docker logs buw-docs-caddy-1`.
	log {
		output stdout
		format console
	}

	header Cache-Control "no-cache"

	# Compress text only, named one by one. Never text/*: it holds text/event-stream, and a chat or run stream
	# must reach the browser piece by piece. Media, images and fonts are already compressed. Only a 200 is
	# encoded, so a 206 range answer, a 304 and a redirect pass through. Caddy adds -zstd or -gzip to the ETag and
	# strips it again from If-None-Match, so conditional requests still reach the service with the plain ETag.
	encode {
		zstd
		gzip
		minimum_length 1024
		match {
			status 200
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type text/markdown*
			header Content-Type text/csv*
			header Content-Type text/yaml*
			header Content-Type text/x-python*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
			header Content-Type model/gltf+json*
			header Content-Type application/wasm*
		}
	}

	# Only the login proxy may say who is signed in.
	@notProxy not remote_ip {$NPM_IP:127.0.0.1}
	request_header @notProxy -Remote-User

	# The content host: card files and nothing else (see the top of this file).
	@contentHost host {$BUW_CONTENT_HOST:content-host.invalid}
	handle @contentHost {
		handle /w/* {
			import npm_only_writes
			header Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-downloads allow-same-origin"
			reverse_proxy {$BUW_SITE_API:buw-site-api:8099}
		}
		handle {
			respond "Not found" 404
		}
	}

	# A card page loaded on the app host (own tab, or any frame or embed) moves to the content host, when there is one,
	# so a page an agent wrote cannot run on the app's origin by being framed from the content host.
	@cardTab {
		expression `"{$BUW_CONTENT_HOST:}" != ""`
		path /w/*
		header_regexp Sec-Fetch-Dest ^(document|iframe|frame|object|embed)$
	}
	handle @cardTab {

		redir https://{$BUW_CONTENT_HOST:}{uri} 302
	}

	# Cards are changed through this: pin, archive, tag, and starting a section. They are written
	# to state.json in the bucket, so the change is there for every device at once.
	handle /api/* {
		import npm_only_writes
		reverse_proxy {$BUW_SITE_API:buw-site-api:8099}
	}

	# Which sections this site serves: every sections/<id>/workspace.json the bucket holds.
	handle /sites.json {
		import npm_only_writes
		reverse_proxy {$BUW_SITE_API:buw-site-api:8099}
	}

	# Each section's own files, streamed from the bucket: /w/<id>/<anything>.
	# The app builds these URLs from sites.json, so a new section needs no rule here.
	handle /w/* {
		import npm_only_writes
		reverse_proxy {$BUW_SITE_API:buw-site-api:8099}
	}

	# The phone app's manifest. Caddy has no type for .webmanifest of its own. (sw.js needs nothing
	# here: it is a file, so try_files below serves it as JavaScript, and the header above applies.)
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# The app itself, for every other path. try_files keeps /magic-loops and /bunnylink working on a
	# reload: they are the app's own addresses, not files.
	handle {
		# The app must not be framed, and must not be reachable through a window another page holds: every card
		# page shares the content host's origin, so a card that framed the app, opened it in a popup, or kept a
		# popup open could script the card frame the app shows and send its save requests as that card.
		header Cross-Origin-Opener-Policy "same-origin"
		header Content-Security-Policy "frame-ancestors 'none'"
		header X-Frame-Options "DENY"
		root * {$BUW_DOCS_ROOT:/srv/buw-docs}/_app/ui
		# Vite's content-hashed JS and CSS (assets/name-<8 chars>.js|css) never change under the same name. `file`
		# matters: a missing name falls back to index.html below, and that answer must not be kept for a year.
		# Inside this handle, so it runs after the site-level no-cache and replaces it.
		@hashedAsset {
			path_regexp `^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css)$`
			file {path}
		}
		header @hashedAsset Cache-Control "private, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
