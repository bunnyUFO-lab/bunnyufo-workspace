{
  "_comment": "Secret patterns and test vectors shared by the Hermes exporter (proxmox-bunnylink scripts/assistant/config-export) and the Hub site API (site/api/hub-agent-config.mjs). Apply the patterns in order, each replacing every match with 'replacement'; count is the total number of replacements. Regexes use syntax common to Python re and JavaScript RegExp; 'ignoreCase' true means the i flag. Keep inputs ASCII. The app test copies this file; its comment names the source.",
  "replacement": "[redacted]",
  "patterns": [
    {
      "regex": "sk-[A-Za-z0-9_-]{16,}",
      "ignoreCase": false
    },
    {
      "regex": "sk-ant-[A-Za-z0-9_-]{16,}",
      "ignoreCase": false
    },
    {
      "regex": "gh[pousr]_[A-Za-z0-9]{20,}",
      "ignoreCase": false
    },
    {
      "regex": "github_pat_[A-Za-z0-9_]{20,}",
      "ignoreCase": false
    },
    {
      "regex": "xox[abprs]-[A-Za-z0-9-]{10,}",
      "ignoreCase": false
    },
    {
      "regex": "AKIA[0-9A-Z]{16}",
      "ignoreCase": false
    },
    {
      "regex": "[MNO][A-Za-z0-9_-]{23,27}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27,40}",
      "ignoreCase": false
    },
    {
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "ignoreCase": false
    },
    {
      "regex": "\\bBearer\\s+[A-Za-z0-9._~+/-]{16,}=*",
      "ignoreCase": true
    },
    {
      "regex": "(?:(?<![A-Za-z0-9])(?:api[_-]?key|token|secret|password)|[_-]key)\\s*[:=]\\s*(?!\\[redacted\\])\\S{8,}",
      "ignoreCase": true
    },
    {
      "regex": "[A-Za-z0-9+/_-]{40,}",
      "ignoreCase": false
    }
  ],
  "cases": [
    {
      "name": "sk key",
      "input": "key sk-abcdefghijklmnop1234 end",
      "expected": "key [redacted] end",
      "count": 1
    },
    {
      "name": "sk key too short",
      "input": "key sk-short end",
      "expected": "key sk-short end",
      "count": 0
    },
    {
      "name": "sk-ant key",
      "input": "x sk-ant-api03-ABCDEFGHIJKLMNOP_qrstuv-12",
      "expected": "x [redacted]",
      "count": 1
    },
    {
      "name": "github token",
      "input": "tok ghp_abcdefghijklmnopqrstuvwx done",
      "expected": "tok [redacted] done",
      "count": 1
    },
    {
      "name": "github fine-grained",
      "input": "github_pat\u005f11ABCDEFG0abcdefghij_klmnop done",
      "expected": "[redacted] done",
      "count": 1
    },
    {
      "name": "slack token",
      "input": "slack xoxb-FAKEFAKEFAKE-ok",
      "expected": "slack [redacted]",
      "count": 1
    },
    {
      "name": "aws access key id",
      "input": "id AKI\u0041ABCDEFGHIJKLMNOP here",
      "expected": "id [redacted] here",
      "count": 1
    },
    {
      "name": "private key block keeps surrounding lines",
      "input": "before\n-----BEGIN RSA PRIVATE KEY-----\nMIIabc\nline2\n-----END RSA PRIVATE KEY-----\nafter",
      "expected": "before\n[redacted]\nafter",
      "count": 1
    },
    {
      "name": "bearer header",
      "input": "Authorization: Bearer abcdefghijklmnop1234== ok",
      "expected": "Authorization: [redacted] ok",
      "count": 1
    },
    {
      "name": "bearer too short",
      "input": "Bearer short",
      "expected": "Bearer short",
      "count": 0
    },
    {
      "name": "bearer is case-insensitive",
      "input": "authorization: bearer abcdefghijklmnop1234",
      "expected": "authorization: [redacted]",
      "count": 1
    },
    {
      "name": "key value with equals",
      "input": "api_key = abcd1234efgh",
      "expected": "[redacted]",
      "count": 1
    },
    {
      "name": "key value with colon",
      "input": "password: hunter2hunter2 stays out",
      "expected": "[redacted] stays out",
      "count": 1
    },
    {
      "name": "key value upper case with dash",
      "input": "API-KEY=xyzxyzxyz",
      "expected": "[redacted]",
      "count": 1
    },
    {
      "name": "key value short value stays",
      "input": "token: abc",
      "expected": "token: abc",
      "count": 0
    },
    {
      "name": "secret word without separator stays",
      "input": "the secret sauce is fine",
      "expected": "the secret sauce is fine",
      "count": 0
    },
    {
      "name": "long opaque run",
      "input": "id AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA end",
      "expected": "id [redacted] end",
      "count": 1
    },
    {
      "name": "39 characters stay",
      "input": "id AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA end",
      "expected": "id AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA end",
      "count": 0
    },
    {
      "name": "long run with slash and plus",
      "input": "blob ab+/cd_-ab+/cd_-ab+/cd_-ab+/cd_-ab+/cd_-ab+/cd_- end",
      "expected": "blob [redacted] end",
      "count": 1
    },
    {
      "name": "ordinary url and text stay",
      "input": "Fetch https://api.example.test/cards.mjs then run `node /tmp/cards.mjs sections`.",
      "expected": "Fetch https://api.example.test/cards.mjs then run `node /tmp/cards.mjs sections`.",
      "count": 0
    },
    {
      "name": "several secrets, newlines kept",
      "input": "a sk-abcdefghijklmnop1234\nb ghp_abcdefghijklmnopqrstuvwx\r\nc password: hunter2hunter2\n",
      "expected": "a [redacted]\nb [redacted]\r\nc [redacted]\n",
      "count": 3
    },
    {
      "name": "discord bot token in an env line",
      "input": "DISCORD_BOT_TOKEN=MTIzNDU2Nzg5MDEyMzQ1Njc4OTA\u002eGAbCdE\u002eaaaaaaaaaaBBBBBBBBBBcccccccccccccccccc",
      "expected": "DISCORD_BOT_TOKEN=[redacted]",
      "count": 1
    },
    {
      "name": "bare discord bot token",
      "input": "bot token is MTIzNDU2Nzg5MDEyMzQ1Njc4OTA\u002eGAbCdE\u002eaaaaaaaaaaBBBBBBBBBBcccccccccccccccccc ok",
      "expected": "bot token is [redacted] ok",
      "count": 1
    },
    {
      "name": "env style password",
      "input": "BUW_CARDS_PASSWORD=Xy7pQ2rT9vW3kL8mN4bH6jF1",
      "expected": "BUW_CARDS_[redacted]",
      "count": 1
    },
    {
      "name": "env style token",
      "input": "HERMES_CONFIG_TOKEN=Xy7pQ2rT9vW3kL8mN4bH6jF1",
      "expected": "HERMES_CONFIG_[redacted]",
      "count": 1
    },
    {
      "name": "env style key with short hex",
      "input": "API_SERVER_KEY=0123456789abcdef0123456789abcdef",
      "expected": "API_SERVER[redacted]",
      "count": 1
    },
    {
      "name": "card token",
      "input": "buwc_A1b2C3d4E5A1b2C3d4E5A1b2C3d4E5A1b2C3d4E5xyz",
      "expected": "[redacted]",
      "count": 1
    },
    {
      "name": "env style value already redacted is not counted twice",
      "input": "password: sk-abcdefghijklmnop1234",
      "expected": "password: [redacted]",
      "count": 1
    },
    {
      "name": "discord bot token starting with O",
      "input": "ODEyMzQ1Njc4OTAxMjM0NTY3.GAbCdE.aaaaaaaaaaBBBBBBBBBBcccccccccccccccccc",
      "expected": "[redacted]",
      "count": 1
    },
    {
      "name": "empty",
      "input": "",
      "expected": "",
      "count": 0
    }
  ]
}
